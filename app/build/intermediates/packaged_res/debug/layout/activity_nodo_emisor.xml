<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado de Nodo Emisor -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CadenaDeFrio.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Emisor"
                    android:src="@drawable/ic_cold_chain_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/titulo_emisor"
                        android:textColor="@color/primary_navy"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simulación de Sensor OT por Bluetooth SPP"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Estado del Servidor Bluetooth -->
        <TextView
            android:id="@+id/tvEstadoServidor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#E8EEF3"
            android:elevation="1dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="NODO EMISOR DETENIDO"
            android:textAlignment="center"
            android:textColor="@color/text_body"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciarServidor"
            style="@style/Widget.CadenaDeFrio.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Iniciar Servidor Bluetooth"
            android:textSize="14sp"
            app:icon="@drawable/ic_bluetooth"
            app:iconSize="16dp" />

        <!-- Tarjeta de Control Térmico -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CadenaDeFrio.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Control de Temperatura Manual"
                    android:textColor="@color/primary_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTempEmisor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/temp_safe_bg"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="Temperatura a emitir: 4.5 °C"
                    android:textAlignment="center"
                    android:textColor="@color/temp_safe"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sbTemperatura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="140"
                    android:progress="45" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rango simulación: 0.0 °C a 14.0 °C"
                    android:textAlignment="center"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Compuerta y Falla -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CadenaDeFrio.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swPuerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Compuerta de Cámara: CERRADA"
                    android:textColor="@color/text_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFallaSensor"
                    style="@style/Widget.CadenaDeFrio.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="Simular Falla de Sensor (ERR)"
                    android:textColor="@color/temp_critical"
                    android:textSize="13sp"
                    app:strokeColor="@color/temp_critical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Consola de Eventos y Comandos OT -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CadenaDeFrio.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/terminal_bg"
            app:cardElevation="2dp"
            app:strokeColor="#2A3B4C">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terminal de Enlace y Comandos OT:"
                    android:textColor="@color/terminal_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLogEmisor"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:scrollbars="vertical"
                    android:text="Listo para iniciar servidor Bluetooth.\n"
                    android:textColor="@color/terminal_text"
                    android:textSize="11sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Volver -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverDashboard"
            style="@style/Widget.CadenaDeFrio.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:text="Volver al Panel de Control"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
